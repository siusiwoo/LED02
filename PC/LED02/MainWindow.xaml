<Window x:Class="LED02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LED02"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="357" Stroke="Black" VerticalAlignment="Top" Width="700" Margin="10,67,0,0"/>
        <ToggleButton Content="시작" HorizontalAlignment="Left" Height="55" Margin="10,107,0,0" VerticalAlignment="Top" Width="173" Checked="ToggleButton_Checked" Unchecked="ToggleButton_UnChecked" x:Name="startButton"/>
        <Rectangle HorizontalAlignment="Left" Height="55" Margin="188,107,0,0" Stroke="Black" VerticalAlignment="Top" Width="167"/>
        <Rectangle HorizontalAlignment="Left" Height="257" Margin="10,167,0,0" Stroke="Black" VerticalAlignment="Top" Width="345"/>
        <DataGrid HorizontalAlignment="Left" Height="317" Margin="360,107,0,0" VerticalAlignment="Top" Width="350" d:ItemsSource="{d:SampleData ItemCount=5}" RenderTransformOrigin="0.5,0.5" x:Name="CalculationHistory" IsReadOnly="True" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="A" Binding="{Binding A}" />
                <DataGridTextColumn Header="B" Binding="{Binding B}" />
                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" />
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox HorizontalAlignment="Left" Height="38" Margin="119,179,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="208"  PreviewTextInput="NumberOnly_PreviewTextInput" x:Name="loopCountTextBox" />
        <TextBox HorizontalAlignment="Left" Height="38" Margin="119,227,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="208" PreviewTextInput="NumberOnly_PreviewTextInput" x:Name="loopIntervalTextBox"/>
        <TextBox HorizontalAlignment="Left" Height="29" Margin="119,285,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="104" PreviewTextInput="SignedNumber_PreviewTextInput" x:Name="aMinTextBox"/>
        <TextBox HorizontalAlignment="Left" Height="29" Margin="228,285,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="104" PreviewTextInput="SignedNumber_PreviewTextInput" x:Name="aMaxTextBox"/>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="119,338,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="104" PreviewTextInput="SignedNumber_PreviewTextInput" x:Name="bMinTextBox"/>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="228,338,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="104" PreviewTextInput="SignedNumber_PreviewTextInput" x:Name="bMaxTextBox"/>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="42,188,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54"><Run Language="ko-kr" Text="반복 횟수"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="42,236,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54"><Run Text="반"/><Run Language="ko-kr" Text="복 간격"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="42,290,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54"><Run Language="ko-kr" Text="A"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="20" Margin="42,343,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54"><Run Language="ko-kr" Text="B"/></TextBlock>
        <Label Content="MIN" HorizontalAlignment="Left" Height="19" Margin="159,266,0,0" VerticalAlignment="Top" Width="52" Background="White" FontSize="6" />
        <Label Content="MAX" HorizontalAlignment="Left" Height="19" Margin="268,266,0,0" VerticalAlignment="Top" Width="52" Background="White" FontSize="6"/>
        <Label Content="MIN" HorizontalAlignment="Left" Height="19" Margin="159,319,0,0" VerticalAlignment="Top" Width="52" Background="White" FontSize="6" />
        <Label Content="MAX" HorizontalAlignment="Left" Height="19" Margin="268,319,0,0" VerticalAlignment="Top" Width="52" Background="White" FontSize="6"/>

        <Ellipse HorizontalAlignment="Left" Height="40" Margin="254,114,0,0" Stroke="Black" VerticalAlignment="Top" Width="40" x:Name="Yellow"/>
        <Button Content="저장하기" HorizontalAlignment="Left" Height="30" Margin="185,383,0,0" VerticalAlignment="Top" Width="145" Click="Save_Click" x:Name="saveButton"/>
        <Button Content="되돌리기" HorizontalAlignment="Left" Height="30" Margin="32,383,0,0" VerticalAlignment="Top" Width="150" Click="Revert_Click" x:Name="revertButton"/>


    </Grid>
</Window>
